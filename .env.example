# Copy to .env (or set in your host's environment). All are optional.
PORT=3000
NODE_ENV=production          # adds the Secure flag to the login cookie (needs HTTPS)
TRUST_PROXY=1                # set when running behind nginx / a load balancer
DATA_DIR=/var/lib/vinc-global # database + uploaded files live here; back this folder up
ADMIN_PASSWORD=Vinc@2026     # only used the very first time, to create the admin account
MAX_UPLOAD_MB=25
