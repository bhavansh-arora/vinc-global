# Copy to .env on the server, next to docker-compose.yml. Never commit the real .env.
# Comments must be on their own lines.

# Outgoing email
SMTP_HOST=send.one.com
SMTP_PORT=587
SMTP_USER=info@vinc-global.com
SMTP_PASS=change-me
MAIL_FROM=VINC Global <info@vinc-global.com>
# Where sign-ups, questions, KYC uploads and ID requests are reported
ADMIN_EMAIL=info@vinc-global.com
# Used for links inside emails
PUBLIC_URL=https://vinc-global.com

# Only used the very first time, to create the admin account
ADMIN_PASSWORD=Vinc@2026
MAX_UPLOAD_MB=25
